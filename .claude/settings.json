{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.*)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*secret*)",
      "Read(/**/*credential*)",
      "Read(/**/*password*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-test.ps1"
          }
        ]
      }
    ]
  }
}
